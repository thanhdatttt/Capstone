[Unit]
Description=SysInfo Node App Service
After=network.target

[Service]
Type=exec
User=svc-info
Group=svc-info
WorkingDirectory=/opt/info-app
ExecStart=/usr/local/bin/node --env-file=.env server.js

# Restart policy
Restart=always
RestartSec=3s

# Standard logging captured by journalctl
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
